---
import ManPageLayout from '../../layouts/ManPageLayout.astro';
import { getProjects, projectPrimaryHref } from '../../lib/content';

const projects = await getProjects();
const links = [
  { id: 'name', label: 'NAME' },
  { id: 'projects', label: 'PROJECTS' },
  { id: 'also', label: 'SEE ALSO' }
];
---

<ManPageLayout
  title="Projects"
  description="Selected open-source projects and experiments by Abdeltwab M. Fakhry."
  manual="PROJECTS(5)"
  links={links}
>
  <section id="name" class="man-section">
    <h2>NAME</h2>
    <h1>
      Projects <small>What it does, why it matters, and where to find it.</small>
    </h1>
  </section>

  <section id="projects" class="man-section">
    <h2>PROJECTS</h2>
    <ol class="project-list concise-projects">
      {projects.map((project) => (
        <li>
          <div class="project-heading">
            <h3>
              <a href={projectPrimaryHref(project)}>{project.data.title}</a>
            </h3>
            <span class="status-label">[{project.data.status}]</span>
          </div>

          <p>{project.data.description}</p>

          {project.data.highlights.length > 0 && (
            <ul class="project-highlights">
              {project.data.highlights.map((highlight) => (
                <li>{highlight}</li>
              ))}
            </ul>
          )}

          <div class="project-footer">
            <span class="project-stack">stack: {project.data.stack.join(' · ')}</span>
            {project.data.license && <span>license: {project.data.license}</span>}
            <nav aria-label={`${project.data.title} links`}>
              {project.data.homepage && <a href={project.data.homepage}>website ↗</a>}
              {project.data.repository && <a href={project.data.repository}>source ↗</a>}
            </nav>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section id="also" class="man-section">
    <h2>SEE ALSO</h2>
    <div class="see-also">
      <a href="/about/">about(7)</a>
      <a href="/uses/">uses(7)</a>
      <a href="https://github.com/AbdeltwabMF">github(1)</a>
    </div>
  </section>
</ManPageLayout>
