---
import ManPageLayout from '../../layouts/ManPageLayout.astro';
import { getPublishedArticles } from '../../lib/content';
const articles = await getPublishedArticles();
const counts = new Map<string, number>();
for (const article of articles)
  for (const tag of article.data.tags) counts.set(tag, (counts.get(tag) ?? 0) + 1);
const tags = [...counts].sort(([a], [b]) => a.localeCompare(b));
const links = [
  { id: 'name', label: 'NAME' },
  { id: 'tags', label: 'TAGS' }
];
---

<ManPageLayout
  title="Tags"
  description="Topics covered in Abdeltwab's writing."
  manual="TAGS(5)"
  links={links}
>
  <section id="name" class="man-section">
    <h2>NAME</h2>
    <h1>
      Tags <small>An index of recurring subjects.</small>
    </h1>
  </section>
  <section id="tags" class="man-section">
    <h2>TAGS</h2>
    <ul class="tool-list">
      {tags.map(([tag, count]) => (
        <li>
          <a href={`/tags/${tag}/`}>{tag}</a>
          <span>
            {count} {count === 1 ? 'entry' : 'entries'}
          </span>
        </li>
      ))}
    </ul>
  </section>
</ManPageLayout>
