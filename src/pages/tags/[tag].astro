---
import ManPageLayout from '../../layouts/ManPageLayout.astro';
import { articleHref, formatDate, getPublishedArticles } from '../../lib/content';
export async function getStaticPaths() {
  const articles = await getPublishedArticles();
  const tags = [...new Set(articles.flatMap((article) => article.data.tags))];
  return tags.map((tag) => ({ params: { tag }, props: { tag } }));
}
const { tag } = Astro.props;
const articles = (await getPublishedArticles()).filter((article) =>
  article.data.tags.includes(tag)
);
const links = [
  { id: 'name', label: 'NAME' },
  { id: 'articles', label: 'ARTICLES' }
];
---

<ManPageLayout
  title={`Tag: ${tag}`}
  description={`Articles tagged ${tag}.`}
  manual="TAG(5)"
  links={links}
>
  <section id="name" class="man-section">
    <h2>NAME</h2>
    <h1>
      {tag}{' '}
      <small>
        {articles.length} {articles.length === 1 ? 'entry' : 'entries'}
      </small>
    </h1>
  </section>
  <section id="articles" class="man-section">
    <h2>ARTICLES</h2>
    <ol class="project-list">
      {articles.map((article) => (
        <li>
          <span class="status-label">
            {article.data.locale.toUpperCase()} ·{' '}
            {formatDate(article.data.publishedAt, article.data.locale)}
          </span>
          <h3>
            <a href={articleHref(article)}>{article.data.title}</a>
          </h3>
          <p>{article.data.description}</p>
        </li>
      ))}
    </ol>
  </section>
</ManPageLayout>
